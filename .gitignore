# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code worktrees / agent scratch
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# 3D robot source assets (converted to public/robot.glb via scripts/build-robot-glb.mjs)
/_source-fbx/
/tmp_glb/

# Android APK binaries — distributed via GitHub Releases, not committed
*.apk

# Journey artifacts, uncropped. The originals carry other people's names and
# faces from Facebook's sidebar plus a personal bookmarks bar; only the cropped
# evidence in public/journey-assets/ is fit to serve.
_source-journey-assets/
_source-journey-art/

# Film masters: raw voiceover exports and intermediate frame renders. The
# finished film is served from public/; none of the source audio or the
# thousands of PNG frames behind it belong in git.
_source-film/
